PORT=5001
JWT_SECRET=your_jwt_secret_here
DATABASE_FILE=database.sqlite

# ── AWS IoT Core (MQTT) ────────────────────────────────────────────────────────
# Go to: AWS IoT Console → Settings → Device data endpoint to get your endpoint
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.your-region.amazonaws.com
AWS_IOT_DEVICE_ID=your-device-id
AWS_IOT_CERT_PATH=./iot/certs/your-device.cert.pem
AWS_IOT_KEY_PATH=./iot/certs/your-device.private.key
AWS_IOT_CA_PATH=./iot/certs/root-ca.pem

# ── AWS Credentials (for DynamoDB) ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# ── DynamoDB Table Names ──────────────────────────────────────────────────────
DYNAMO_TELEMETRY_TABLE=hydrosmart-telemetry
DYNAMO_PUMP_TABLE=hydrosmart-pump-state
DYNAMO_ALERTS_TABLE=hydrosmart-alerts
DYNAMO_ALERT_HISTORY_TABLE=hydrosmart-alert-history
DYNAMO_SCHEDULES_TABLE=hydrosmart-schedules
DYNAMO_SETTINGS_TABLE=hydrosmart-settings
DYNAMO_DEVICE_ID=your-device-id
